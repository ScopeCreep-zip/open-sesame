[Unit]
Description=Open Sesame secrets daemon
Documentation=https://github.com/scopecreep-zip/open-sesame
Requires=open-sesame-profile.service
After=open-sesame-profile.service
PartOf=open-sesame-headless.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
ExecStart=/usr/bin/daemon-secrets
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
WatchdogSec=30
NoNewPrivileges=yes

# Security hardening — strictest of all daemons
PrivateNetwork=yes
ProtectHome=read-only
ProtectSystem=strict
# Unix-domain sockets of the native ABI only, and no session D-Bus bus (it
# reaches the user's service manager); the in-process seccomp filter and
# Landlock enforce the same, Landlock from Linux 7.1 (ResolveUnix); below it,
# InaccessiblePaths is the one layer that hides the bus.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
InaccessiblePaths=-%t/bus

# Owner-only, as daemon-secrets keeps it (see open-sesame-profile.service).
ConfigurationDirectory=pds
ConfigurationDirectoryMode=0700
ReadWritePaths=%t/pds
ReadWritePaths=%E/pds

# Landlock + seccomp applied in-process (see daemon-secrets apply_sandbox)

# Resource limits
LimitNOFILE=1024
LimitCORE=0
LimitMEMLOCK=64M
MemoryMax=256M

# Environment
Environment=RUST_LOG=info

[Install]
WantedBy=open-sesame-headless.target
