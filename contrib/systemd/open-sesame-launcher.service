[Unit]
Description=Open Sesame launcher daemon
Documentation=https://github.com/scopecreep-zip/open-sesame
Requires=open-sesame-profile.service
After=open-sesame-profile.service
PartOf=open-sesame-headless.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
ExecStart=/usr/bin/daemon-launcher
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
WatchdogSec=30

# daemon-launcher spawns arbitrary desktop applications. Mount namespace
# restrictions (ProtectHome, ProtectSystem, PrivateTmp, PrivateDevices)
# and cgroup limits (MemoryMax) inherit to children — even through
# systemd-run --scope — because scopes share the caller's mount namespace.
# Evidence: firefox child gets "Read-only file system" on /run/user/1000/dconf/
# when ProtectSystem=strict is set here.
NoNewPrivileges=yes

# Kernel control plane, through the mount namespace (read-only /proc/sys
# and cgroup tree), inherited by launched applications.
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# Nothing that drops the capability bounding set: CapabilityBoundingSet=,
# ProtectClock= (CAP_SYS_TIME, CAP_WAKE_ALARM), ProtectKernelModules=
# (CAP_SYS_MODULE), ProtectKernelLogs= (CAP_SYSLOG). A user manager drops
# them only with CAP_SETPCAP in the service's user namespace, which a
# kernel.apparmor_restrict_unprivileged_userns=1 host (Ubuntu 24.04's
# default) denies, failing the start with 218/CAPABILITIES; the bounding
# set would also bind every application launched. The service holds no
# capability in the initial user namespace to drop, and runs with
# NoNewPrivileges=yes.

# Children spawned via systemd-run --scope survive launcher restarts.
KillMode=process

# Resource limits
LimitNOFILE=4096
LimitCORE=0
LimitMEMLOCK=64M

# Environment
Environment=RUST_LOG=info

[Install]
WantedBy=open-sesame-headless.target
