[Unit]
Description=Open Sesame window manager daemon
Documentation=https://github.com/scopecreep-zip/open-sesame
Requires=open-sesame-profile.service
After=open-sesame-profile.service
PartOf=open-sesame-desktop.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=notify
ExecStart=/usr/bin/daemon-wm
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
WatchdogSec=30
NoNewPrivileges=yes

# Security hardening
ProtectHome=read-only
ProtectSystem=strict
# Unix-domain sockets of the native ABI only, and no session D-Bus bus (it
# reaches the user's service manager); the in-process seccomp filter and
# Landlock enforce the same, Landlock from Linux 7.1 (ResolveUnix); below it,
# InaccessiblePaths is the one layer that hides the bus.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
InaccessiblePaths=-%t/bus

ReadWritePaths=%t/pds
ReadWritePaths=%h/.cache/open-sesame
ReadWritePaths=%h/.cache/fontconfig

# Resource limits
LimitNOFILE=4096
LimitCORE=0
LimitMEMLOCK=64M
MemoryMax=128M

# Environment
Environment=RUST_LOG=info
EnvironmentFile=-%h/.config/pds/ssh-agent.env

[Install]
WantedBy=open-sesame-desktop.target
