# %preun for open-sesame (headless)
# $1: 0=remove, >=1=upgrade

sesame_require_systemd

if [ "$1" -eq 0 ]; then
    # Removal: disable and stop via systemd-update-helper.
    # remove-user-units calls systemctl --global disable then
    # systemctl --user -M "$user@" disable --now per active user.
    if [ -x /usr/lib/systemd/systemd-update-helper ]; then
        /usr/lib/systemd/systemd-update-helper remove-user-units \
            open-sesame-profile.service \
            open-sesame-secrets.service \
            open-sesame-launcher.service \
            open-sesame-snippets.service \
            open-sesame-headless.target \
            || :
    fi
fi

# $1>=1 (upgrade): no-op. New package's %posttrans handles restart.

:
