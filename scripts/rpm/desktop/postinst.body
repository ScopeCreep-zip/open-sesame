# %post scriptlet for open-sesame-desktop
# $1: 1=install, >=2=upgrade

if [ "$1" -eq 1 ]; then
    if [ -x /usr/lib/systemd/systemd-update-helper ]; then
        /usr/lib/systemd/systemd-update-helper install-user-units \
            open-sesame-wm.service \
            open-sesame-clipboard.service \
            open-sesame-input.service \
            open-sesame-desktop.target \
            || :
    fi

    reload_user_managers

    for uid in $(active_user_uids); do
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-wm.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-clipboard.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-input.service 2>/dev/null || :
    done

    echo ""
    echo "open-sesame-desktop installed!"
    echo "  Desktop daemons enabled: window manager, clipboard, input"
    echo ""
    echo "Verify services:"
    echo "  sesame status"
    echo "  systemctl --user list-units 'open-sesame-*'"
    echo ""
    echo "NOTE: daemon-input requires 'input' group membership for keyboard capture."
    echo "  sudo usermod -aG input \$USER"
    echo "  (logout and login required)"
    echo ""
fi

:
