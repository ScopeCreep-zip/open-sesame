# %preun scriptlet for open-sesame-desktop
# $1: 0=remove, >=1=upgrade

if [ "$1" -eq 0 ]; then
    for uid in $(active_user_uids); do
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            stop open-sesame-input.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            stop open-sesame-clipboard.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            stop open-sesame-wm.service 2>/dev/null || :
    done

    if [ -x /usr/lib/systemd/systemd-update-helper ]; then
        /usr/lib/systemd/systemd-update-helper remove-user-units \
            open-sesame-wm.service \
            open-sesame-clipboard.service \
            open-sesame-input.service \
            open-sesame-desktop.target \
            || :
    fi
fi

:
