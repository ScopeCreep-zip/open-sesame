# %post scriptlet for open-sesame (headless)
# $1: 1=install, >=2=upgrade

if [ "$1" -eq 1 ]; then
    # First install: apply preset policy (enable services)
    if [ -x /usr/lib/systemd/systemd-update-helper ]; then
        /usr/lib/systemd/systemd-update-helper install-user-units \
            open-sesame-profile.service \
            open-sesame-secrets.service \
            open-sesame-launcher.service \
            open-sesame-snippets.service \
            open-sesame-headless.target \
            || :
    fi

    # Reload user managers so they see the new unit files, then start services
    reload_user_managers

    for uid in $(active_user_uids); do
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-profile.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-secrets.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-launcher.service 2>/dev/null || :
        SYSTEMD_BUS_TIMEOUT=15s systemctl --user -M "$uid@" \
            restart open-sesame-snippets.service 2>/dev/null || :
    done

    echo ""
    echo "open-sesame installed successfully!"
    echo "  Headless daemons enabled: profile, secrets, launcher, snippets"
    echo ""
    echo "First-time setup:"
    echo "  sesame init"
    echo ""
    echo "Verify services:"
    echo "  sesame status"
    echo "  journalctl --user -u open-sesame-profile --since '1 min ago'"
    echo ""
    echo "For desktop features (window switcher, clipboard, input capture):"
    echo "  sudo dnf install open-sesame-desktop"
    echo ""
fi

# On upgrade ($1>=2): no restart here. %posttrans handles it via
# mark-restart-user-units after all packages in the transaction complete.

:
