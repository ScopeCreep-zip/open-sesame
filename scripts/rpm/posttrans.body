# %posttrans scriptlet for open-sesame (headless)
#
# posttrans runs after ALL packages in the transaction complete.
# Correct place for upgrade restarts: new binaries installed, old
# package cleanup done, desktop units in place if co-installed.

if [ -x /usr/lib/systemd/systemd-update-helper ]; then
    /usr/lib/systemd/systemd-update-helper mark-restart-user-units \
        open-sesame-profile.service \
        open-sesame-secrets.service \
        open-sesame-launcher.service \
        open-sesame-snippets.service \
        || :
fi

:
