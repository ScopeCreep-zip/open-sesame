# %prerm for open-sesame (headless) -- deb
case "$1" in
    remove|deconfigure)
        sesame_require_systemd

        for uid in $(sesame_active_user_uids); do
            sesame_user_systemctl "$uid" stop open-sesame-snippets.service
            sesame_user_systemctl "$uid" stop open-sesame-launcher.service
            sesame_user_systemctl "$uid" stop open-sesame-secrets.service
            sesame_user_systemctl "$uid" stop open-sesame-profile.service
        done

        systemctl --global disable \
            open-sesame-profile.service \
            open-sesame-secrets.service \
            open-sesame-launcher.service \
            open-sesame-snippets.service \
            open-sesame-headless.target \
            2>/dev/null || true
        #DEBHELPER#
        ;;
    upgrade)
        sesame_require_systemd

        for uid in $(sesame_active_user_uids); do
            sesame_user_systemctl "$uid" stop open-sesame-snippets.service
            sesame_user_systemctl "$uid" stop open-sesame-launcher.service
            sesame_user_systemctl "$uid" stop open-sesame-secrets.service
            sesame_user_systemctl "$uid" stop open-sesame-profile.service
        done
        #DEBHELPER#
        ;;
esac

exit 0
