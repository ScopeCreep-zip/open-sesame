# check=skip=SecretsUsedInArgOrEnv
# Open Sesame base environment -- Arch Linux with systemd
#
# x86_64 only (official archlinux image does not support aarch64).
#
# Base image only. Package installation happens via docker exec after
# the container is running. See compose profiles for install methods:
#   source: cargo build from mounted repo
#   local:  pacman -U from mounted prebuilt packages
#   repo:   pacman -Syu from GitHub Pages pacman repository
#
# Shell:  docker exec -it --user arch open-sesame-arch bash
# Verify: docker exec --user arch open-sesame-arch sesame status --doctor --exit-code

FROM archlinux:latest

ARG USERNAME=arch
ARG USER_UID=1000

# =============================================================================
# System packages
# =============================================================================
RUN pacman -Syu --noconfirm \
    systemd \
    dbus \
    curl \
    sudo \
    openssh \
    && pacman -Scc --noconfirm

# =============================================================================
# systemd configuration for container environment
# Note: systemd-logind is NOT masked -- required for pam_systemd
# =============================================================================
RUN systemctl mask \
    getty.target \
    console-getty.service \
    systemd-networkd.service \
    systemd-resolved.service \
    systemd-timesyncd.service \
    systemd-hostnamed.service \
    systemd-machined.service \
    systemd-journald-audit.socket \
    systemd-udevd.service \
    systemd-udev-trigger.service \
    systemd-firstboot.service \
    systemd-machine-id-commit.service \
    first-boot-complete.target

RUN systemctl set-default multi-user.target

# =============================================================================
# PAM override for user@.service in container
# =============================================================================
COPY .config/docker/data/common/etc/pam.d/systemd-user /etc/pam.d/systemd-user

# =============================================================================
# Create user with linger
# =============================================================================
RUN useradd -m -s /bin/bash -u ${USER_UID} -G wheel ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

RUN mkdir -p \
      /home/${USERNAME}/.config/pds \
      /home/${USERNAME}/.cache/open-sesame \
      /home/${USERNAME}/.ssh \
    && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME} \
    && mkdir -p /var/lib/systemd/linger \
    && touch /var/lib/systemd/linger/${USERNAME}

# =============================================================================
# Initialize pacman keyring (required for signed repo installs)
# =============================================================================
RUN pacman-key --init

# =============================================================================
# Container-specific user units (ssh-agent, sesame-init)
# =============================================================================
COPY .config/docker/data/common/etc/systemd/user/ssh-agent.service /usr/lib/systemd/user/ssh-agent.service
COPY .config/docker/data/common/etc/systemd/user/sesame-init.service /usr/lib/systemd/user/sesame-init.service
COPY .config/docker/data/common/usr/local/bin/sesame-init.sh /usr/local/bin/sesame-init.sh
COPY scripts/docker/post-install.sh /usr/local/bin/post-install.sh
COPY scripts/docker/install-arch-repo.sh /usr/local/bin/install-repo.sh
COPY scripts/docker/install-arch-local.sh /usr/local/bin/install-local.sh
RUN chmod 755 /usr/local/bin/sesame-init.sh /usr/local/bin/post-install.sh \
    && systemctl --global enable ssh-agent.service sesame-init.service

# =============================================================================
# Runtime environment
# =============================================================================
ENV HOME=/home/${USERNAME}
ENV XDG_RUNTIME_DIR=/run/user/${USER_UID}
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${USER_UID}/bus
ENV SSH_AUTH_SOCK=/run/user/${USER_UID}/ssh-agent.sock

WORKDIR /home/${USERNAME}
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/lib/systemd/systemd"]
