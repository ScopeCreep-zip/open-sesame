[Unit]
Description=SSH agent for ubuntu
After=user@1000.service
Before=sesame-init.service

[Service]
Type=forking
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
ExecStartPre=/bin/bash -c '[ -f /home/ubuntu/.ssh/id_ed25519 ] || /usr/bin/ssh-keygen -t ed25519 -f /home/ubuntu/.ssh/id_ed25519 -N "" -q'
ExecStart=/usr/bin/ssh-agent -a /run/user/1000/ssh-agent.sock
ExecStartPost=/bin/bash -c 'SSH_AUTH_SOCK=/run/user/1000/ssh-agent.sock /usr/bin/ssh-add /home/ubuntu/.ssh/id_ed25519'
RemainAfterExit=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
