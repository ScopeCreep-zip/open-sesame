# Open Sesame DEB install verification — Ubuntu 24.04 with systemd
#
# Full Linux environment for package install testing:
# - systemd as PID 1 with logind for user manager sessions
# - PAM override permits user@.service without /etc/shadow auth
# - Linger-enabled user for persistent user services
# - SSH agent with generated keypair for non-interactive sesame init
# - Packages downloaded from GitHub Releases at build time
#
# Shell:  docker exec -it --user ubuntu open-sesame-ubuntu bash
# Verify: docker exec --user ubuntu open-sesame-ubuntu sesame --version
# Status: docker exec --user ubuntu open-sesame-ubuntu sesame status

FROM ubuntu:24.04

ARG VERSION
ARG ARCH

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# =============================================================================
# System packages
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    dbus \
    curl \
    ca-certificates \
    sudo \
    procps \
    openssh-client \
    libpam-systemd \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# systemd configuration for container environment
# Note: systemd-logind is NOT masked — it is required for pam_systemd
# session registration which enables user@.service startup.
# =============================================================================
RUN systemctl mask \
    getty.target \
    console-getty.service \
    systemd-networkd.service \
    systemd-resolved.service \
    systemd-timesyncd.service \
    systemd-hostnamed.service \
    systemd-machined.service \
    systemd-journald-audit.socket \
    systemd-udevd.service \
    systemd-udev-trigger.service \
    systemd-firstboot.service \
    systemd-machine-id-commit.service \
    first-boot-complete.target

RUN systemctl set-default multi-user.target

# =============================================================================
# PAM override: permit user@.service without /etc/shadow authentication
# while preserving pam_systemd session setup for XDG_RUNTIME_DIR and logind
# =============================================================================
COPY .config/docker/data/common/etc/pam.d/systemd-user /etc/pam.d/systemd-user

# =============================================================================
# Use built-in ubuntu user (UID 1000, already in sudo group)
# Enable linger for persistent user services without login session
# =============================================================================
RUN mkdir -p \
      /home/ubuntu/.config/pds \
      /home/ubuntu/.cache/open-sesame \
      /home/ubuntu/.ssh \
    && chown -R ubuntu:ubuntu /home/ubuntu \
    && mkdir -p /var/lib/systemd/linger \
    && touch /var/lib/systemd/linger/ubuntu

# =============================================================================
# SSH agent and sesame-init services
# =============================================================================
COPY .config/docker/data/ubuntu/etc/systemd/system/ssh-agent.service /etc/systemd/system/ssh-agent.service
COPY .config/docker/data/ubuntu/etc/systemd/system/sesame-init.service /etc/systemd/system/sesame-init.service
COPY .config/docker/data/ubuntu/usr/local/bin/sesame-init.sh /usr/local/bin/sesame-init.sh
RUN chmod 755 /usr/local/bin/sesame-init.sh \
    && systemctl enable ssh-agent.service sesame-init.service

# =============================================================================
# Install open-sesame from GitHub Releases
# =============================================================================
RUN curl -fsSL "https://github.com/ScopeCreep-zip/open-sesame/releases/download/v${VERSION}/open-sesame-linux-${ARCH}.deb" -o /tmp/open-sesame.deb \
    && curl -fsSL "https://github.com/ScopeCreep-zip/open-sesame/releases/download/v${VERSION}/open-sesame-desktop-linux-${ARCH}.deb" -o /tmp/open-sesame-desktop.deb \
    && apt-get update \
    && apt-get install -y /tmp/open-sesame.deb /tmp/open-sesame-desktop.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/*.deb

# =============================================================================
# Runtime environment for docker exec --user ubuntu
# =============================================================================
ENV HOME=/home/ubuntu
ENV XDG_RUNTIME_DIR=/run/user/1000
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ENV SSH_AUTH_SOCK=/run/user/1000/ssh-agent.sock

WORKDIR /home/ubuntu
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/lib/systemd/systemd"]
