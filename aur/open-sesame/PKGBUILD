# Maintainer: Kat Morgan <usrbinkat at braincraft dot io>
# https://github.com/ScopeCreep-zip/open-sesame
#
# Source build from release tarball. Requires Rust >= 1.97 (edition 2024).
# The rust-toolchain.toml in the source tree pins 1.97; rustup users get
# the correct toolchain automatically. Arch extra/rust users may need rustup.
#
# Tests require raised RLIMIT_MEMLOCK (memfd_secret allocations).
# Build with: makepkg --nocheck  (or raise memlock: ulimit -l 262144)
pkgbase=open-sesame
pkgname=('open-sesame' 'open-sesame-desktop')
pkgver=VERSION
pkgrel=1
pkgdesc="Programmable desktop suite: encrypted vaults, trust profiles, window switching, clipboard, input capture"
arch=('x86_64' 'aarch64')
url="https://github.com/ScopeCreep-zip/open-sesame"
license=('GPL-3.0-only')
makedepends=(
    'cargo'
    'gcc-libs'
    'pkgconf'
    'libseccomp'
    'wayland'
    'libxkbcommon'
    'fontconfig'
    'freetype2'
)
options=('!lto')
source=("${url}/releases/download/v${pkgver}/${pkgbase}-${pkgver}-source.tar.gz")
sha256sums=('SOURCE_SHA')

prepare() {
    cd "${pkgbase}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${pkgbase}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
    # xtask is in exclude=["xtask"] so --workspace does not build it
    cargo build --frozen --release --manifest-path xtask/Cargo.toml
    cargo xtask man
    cargo xtask completions
}

check() {
    cd "${pkgbase}-${pkgver}"
    # Tests require raised RLIMIT_MEMLOCK for memfd_secret allocations.
    # Skip if the current limit is insufficient.
    local memlock_kb
    memlock_kb=$(ulimit -l 2>/dev/null || echo 0)
    if [ "${memlock_kb}" -lt 262144 ]; then
        echo "WARNING: RLIMIT_MEMLOCK too low (${memlock_kb} KiB < 256 MiB). Skipping tests."
        echo "  To run tests: ulimit -l 262144 && makepkg --check"
        return 0
    fi
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package_open-sesame() {
    install=open-sesame.install
    pkgdesc="Encrypted secret vaults, trust profiles, application launching, and snippet expansion"
    depends=('glibc' 'gcc-libs' 'libseccomp')
    optdepends=(
        'openssh: SSH agent authentication'
        'open-sesame-desktop: window switcher, clipboard, input capture'
    )
    conflicts=('open-sesame-bin' 'sesame')

    cd "${pkgbase}-${pkgver}"

    install -Dm755 target/release/sesame "${pkgdir}/usr/bin/sesame"
    install -Dm755 target/release/daemon-profile "${pkgdir}/usr/bin/daemon-profile"
    install -Dm755 target/release/daemon-secrets "${pkgdir}/usr/bin/daemon-secrets"
    install -Dm755 target/release/daemon-launcher "${pkgdir}/usr/bin/daemon-launcher"
    install -Dm755 target/release/daemon-snippets "${pkgdir}/usr/bin/daemon-snippets"

    install -Dm644 contrib/systemd/open-sesame-headless.target "${pkgdir}/usr/lib/systemd/user/open-sesame-headless.target"
    install -Dm644 contrib/systemd/open-sesame-profile.service "${pkgdir}/usr/lib/systemd/user/open-sesame-profile.service"
    install -Dm644 contrib/systemd/open-sesame-secrets.service "${pkgdir}/usr/lib/systemd/user/open-sesame-secrets.service"
    install -Dm644 contrib/systemd/open-sesame-launcher.service "${pkgdir}/usr/lib/systemd/user/open-sesame-launcher.service"
    install -Dm644 contrib/systemd/open-sesame-snippets.service "${pkgdir}/usr/lib/systemd/user/open-sesame-snippets.service"

    install -Dm644 contrib/systemd/user-preset/90-open-sesame.preset "${pkgdir}/usr/lib/systemd/user-preset/90-open-sesame.preset"

    install -Dm644 target/man/sesame.1.gz "${pkgdir}/usr/share/man/man1/sesame.1.gz"
    install -Dm644 target/completions/sesame.bash "${pkgdir}/usr/share/bash-completion/completions/sesame"
    install -Dm644 target/completions/_sesame "${pkgdir}/usr/share/zsh/site-functions/_sesame"
    install -Dm644 target/completions/sesame.fish "${pkgdir}/usr/share/fish/vendor_completions.d/sesame.fish"
    install -Dm644 config.example.toml "${pkgdir}/usr/share/doc/open-sesame/config.example.toml"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_open-sesame-desktop() {
    install=open-sesame-desktop.install
    pkgdesc="Vimium-style window switcher, clipboard manager, and keyboard input capture for COSMIC/Wayland"
    depends=("open-sesame=${pkgver}" 'glibc' 'gcc-libs' 'libseccomp' 'libxkbcommon' 'wayland' 'fontconfig' 'freetype2')
    optdepends=(
        'xdg-utils: xdg-open integration'
        'ttf-dejavu: default UI font'
    )
    conflicts=('open-sesame-desktop-bin')

    cd "${pkgbase}-${pkgver}"

    install -Dm755 target/release/daemon-wm "${pkgdir}/usr/bin/daemon-wm"
    install -Dm755 target/release/daemon-clipboard "${pkgdir}/usr/bin/daemon-clipboard"
    install -Dm755 target/release/daemon-input "${pkgdir}/usr/bin/daemon-input"

    install -Dm644 contrib/systemd/open-sesame-desktop.target "${pkgdir}/usr/lib/systemd/user/open-sesame-desktop.target"
    install -Dm644 contrib/systemd/open-sesame-wm.service "${pkgdir}/usr/lib/systemd/user/open-sesame-wm.service"
    install -Dm644 contrib/systemd/open-sesame-clipboard.service "${pkgdir}/usr/lib/systemd/user/open-sesame-clipboard.service"
    install -Dm644 contrib/systemd/open-sesame-input.service "${pkgdir}/usr/lib/systemd/user/open-sesame-input.service"

    install -Dm644 contrib/systemd/user-preset/90-open-sesame-desktop.preset "${pkgdir}/usr/lib/systemd/user-preset/90-open-sesame-desktop.preset"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
